# Server Configuration
PORT=8080
NODE_ENV=development

# AI Image Generation Provider Selection: "openai" | "replicate" | "stability" | "mock"
AI_PROVIDER=mock

# OpenAI API Key (for DALL-E 3)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Replicate API Token (for Flux.1-pro or Flux.1-schnell)
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# Stability AI Key (for SDXL / Stable Diffusion 3.5)
STABILITY_API_KEY=sk-your-stability-api-key-here

# Cloudflare R2 / AWS S3 Storage (Optional)
S3_BUCKET_NAME=aurawall-cdn
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
